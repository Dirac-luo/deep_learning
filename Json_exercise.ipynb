    "import json\n",
    "data = {\n",
    "    \"name\": \"Bob\",\n",
    "    \"age\": 22,\n",
    "    \"hobbies\": [\"read\", \"swimming\"]\n",
    "}\n",
    "\n",
    "json_str = json.dumps(data, indent=3)\n",
    "print(json_str)\n",
    "print(type(json_str))"
